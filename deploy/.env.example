# 复制为 deploy/.env，然后 chmod 600 deploy/.env。
# 不要把真实 .env 提交入库；本文件只放占位值。

# Postgres 密码。会被拼进 HDD_DATABASE_URL，请使用 URL 安全的字符（建议仅字母数字）。
POSTGRES_PASSWORD=replace-with-long-random-alphanumeric-password

# NAS 上的数据目录（Postgres + SeaweedFS 都会落到这里）。必须是数据盘，不要放系统盘。
HDD_DATA_DIR=/vol1/1000/docker/healthyduoduo

# 文件型 secret 目录；目录内放 llm_api_key（可选）。是否启用解释层由下面的 endpoint / model 决定。
HDD_LLM_SECRET_DIR=/vol1/1000/docker/healthyduoduo/secrets

# 解释层（可选）：配置 OpenAI 兼容端点与模型后启用；API key 可选。
# Ollama 示例；NAS 上请把 host.docker.internal 换成 NAS 的局域网 IP。
# HDD_LLM_BASE_URL=http://host.docker.internal:11434/v1
# HDD_LLM_MODEL=qwen3.5:4b
# HDD_LLM_REASONING_EFFORT=none   # 留空则省略；不识别该字段的端点可留空

# 只对局域网开放时，保持 0.0.0.0；只想本机调试时改成 127.0.0.1。
HDD_BIND_ADDR=0.0.0.0

# 宿主端口：避开 8xxx，App 里手输 http://<NAS_IP>:19080/api/v1。
HDD_SERVE_PORT=19080

TZ=Asia/Shanghai
HDD_ANALYSIS_DAILY_LIMIT=20

# 构建产物 tag。建议带日期/commit，例如 healthyduoduo/hdd:nas-20261125；
# 交叉构建或 docker save/load 时，把 image 与 tag 对齐。
HDD_IMAGE=healthyduoduo/hdd:nas
RECOGNIZER_IMAGE=healthyduoduo/recognizer:nas

# 建议锁到测试过的 SeaweedFS tag 或 digest；latest 只用于首次试跑。
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:latest
POSTGRES_IMAGE=postgres:17-alpine

# USB 备份仓库根目录（backup-usb.sh 使用；必须是 USB 挂载点下的目录）。
BACKUP_ROOT=/mnt/usb/healthyduoduo-backup

# restic 仓库密码文件；首次用 openssl rand -base64 32 生成，chmod 600。
RESTIC_PASSWORD_FILE=/vol1/1000/docker/healthyduoduo/secrets/restic_password
RESTIC_IMAGE=restic/restic:latest
